# EduSmart runtime configuration
# Paths may be absolute or relative to the repository root.

# -------------------------------
# Application Settings
# -------------------------------
APP_NAME=EduSmart
APP_ENV=development
APP_DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------
# FastAPI / Server Settings
# -------------------------------
FASTAPI_WORKERS=1
FASTAPI_RELOAD=true

# -------------------------------
# Database Configuration
# -------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/edusmart

# -------------------------------
# Authentication / Security
# -------------------------------
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------------------
# LLM Configuration (llama.cpp)
# -------------------------------
LLM_BACKEND=llama.cpp
LLM_MODE=cpu
LLAMA_CPP_BINARY=./bin/llama-cli

QUERY_LLM_ENABLED=true
QUERY_LLM_MODEL_FAMILY=phi-3-mini
QUERY_LLM_MODEL_CPU_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf
QUERY_LLM_MODEL_DESKTOP_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf
QUERY_LLM_MODEL_GPU_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf
QUERY_LLM_CONTEXT_SIZE=2048
QUERY_LLM_THREADS=8
QUERY_LLM_MAX_TOKENS=1024
QUERY_LLM_TEMPERATURE=0.3
QUERY_LLM_TOP_P=0.9
QUERY_LLM_N_GPU_LAYERS=8
QUERY_LLM_N_BATCH=128
QUERY_LLM_GPU_F16_KV=true

FINAL_LLM_ENABLED=true
FINAL_LLM_MODEL_FAMILY=gemma
FINAL_LLM_MODEL_CPU_PATH=./models/gemma-3n-q4_k_m.gguf
FINAL_LLM_MODEL_DESKTOP_PATH=./models/gemma-3-4b-pt-q4_0.gguf
FINAL_LLM_MODEL_GPU_PATH=./models/gemma-3n-q4_k_m.gguf
FINAL_LLM_CONTEXT_SIZE=4096
FINAL_LLM_THREADS=8
FINAL_LLM_MAX_TOKENS=1024
FINAL_LLM_TEMPERATURE=0.7
FINAL_LLM_TOP_P=0.9
FINAL_LLM_N_GPU_LAYERS=12
FINAL_LLM_N_BATCH=256
FINAL_LLM_GPU_F16_KV=true

# -------------------------------
# Embedding Models
# -------------------------------
EMBEDDING_MODEL_NAME=intfloat/e5-base-v2
EMBEDDING_DEVICE=cpu
BLOOM_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# -------------------------------
# Vector DB / Runtime Data
# -------------------------------
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/chroma_db
VECTOR_DB_COLLECTION=edusmart_knowledge_base

DATA_ROOT=./data
CURRICULUM_DOCS_DIR=./data/curriculum_docs
LECTURER_UPLOADS_DIR=./data/lecturer_uploads
RAW_IMAGES_DIR=./data/raw_images
EMBEDDINGS_DIR=./data/embeddings
INGESTION_UPLOADS_DIR=./data/uploads
COURSE_SPECS_DOCS_DIR=./docs

# -------------------------------
# File Upload & Ingestion
# -------------------------------
MAX_UPLOAD_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,pptx,jpg,jpeg,png
TEXT_CHUNK_SIZE=500
TEXT_CHUNK_OVERLAP=100

# -------------------------------
# OCR
# -------------------------------
OCR_ENABLED=false
OCR_ENGINE=tesseract
OCR_LANGUAGE=eng

# -------------------------------
# Logging
# -------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log

# -------------------------------
# Feature Flags
# -------------------------------
ENABLE_MOCK_LLM=false
ENABLE_RAG=true
ENABLE_INGESTION=true
